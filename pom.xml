<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================
         Project Coordinates
         These three values uniquely identify your project
         in the Maven ecosystem.
    =================================================== -->
    <groupId>com.exampro</groupId>
    <artifactId>ExamPro</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!--
        WAR packaging tells Maven to bundle this as a Web Application Archive,
        which Tomcat can deploy directly.
    -->
    <packaging>war</packaging>

    <name>ExamPro - Exam Management System</name>
    <description>A full-featured Exam Management System built with Java Servlets, JSP, and JDBC</description>

    <!-- ===================================================
         Properties
         Centralised version numbers and encoding settings.
    =================================================== -->
    <properties>
        <!-- Java version - Using Java 17 bytecode for Tomcat 10.1 compatibility.
             Java 25 (installed JDK) compiles with release 17 flag cleanly. -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- All source files must be read as UTF-8 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Dependency Versions (change here, updates everywhere below) -->
        <jakarta.servlet.version>6.0.0</jakarta.servlet.version>
        <jakarta.servlet.jsp.version>3.1.1</jakarta.servlet.jsp.version>
        <jakarta.servlet.jstl.version>3.0.1</jakarta.servlet.jstl.version>
        <mysql.connector.version>9.3.0</mysql.connector.version>
        <bcrypt.version>0.10.2</bcrypt.version>
    </properties>

    <!-- ===================================================
         Dependencies
    =================================================== -->
    <dependencies>

        <!--
            Jakarta Servlet API 6.0
            Scope "provided" = compile against it but do NOT
            bundle it in the WAR. Tomcat 10.1 ships with it.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta.servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Jakarta Server Pages (JSP) API 3.1
            Also "provided" - Tomcat ships with JSP support.
        -->
        <dependency>
            <groupId>jakarta.servlet.jsp</groupId>
            <artifactId>jakarta.servlet.jsp-api</artifactId>
            <version>${jakarta.servlet.jsp.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Jakarta Standard Tag Library (JSTL) 3.0
            Provides c:forEach, c:if, fmt:formatDate, etc.
            Must be bundled in WAR - Tomcat does NOT ship JSTL.
        -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>${jakarta.servlet.jstl.version}</version>
        </dependency>

        <!-- JSTL runtime implementation -->
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>${jakarta.servlet.jstl.version}</version>
        </dependency>

        <!--
            MySQL Connector/J 9.x
            JDBC driver for MySQL database connectivity.
            Bundled inside the WAR.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
        </dependency>

        <!--
            BCrypt Password Hashing
            Standalone BCrypt library - no framework dependencies.
            Passwords are NEVER stored as plain text.
        -->
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>${bcrypt.version}</version>
        </dependency>

        <!--
            Jakarta Mail API 2.1 & Angus Mail Implementation
            Standards-based mailing for account alerts and exam notifications.
        -->
        <dependency>
            <groupId>jakarta.mail</groupId>
            <artifactId>jakarta.mail-api</artifactId>
            <version>2.1.3</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
            <version>2.0.3</version>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <!-- ===================================================
         Build Configuration
    =================================================== -->
    <build>
        <!-- The final WAR file name: ExamPro.war -->
        <finalName>ExamPro</finalName>

        <plugins>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
                Maven WAR Plugin
                failOnMissingWebXml=false allows annotation-based
                servlet configuration without a web.xml.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <warSourceDirectory>src/main/webapp</warSourceDirectory>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
