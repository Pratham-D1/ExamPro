<?xml version="1.0" encoding="UTF-8"?>
<!--
    web.xml - Web Application Deployment Descriptor
    ════════════════════════════════════════════════
    This file tells Tomcat how to configure your web application:
    - The Servlet version (6.0 for Tomcat 10.1 / Jakarta EE 10)
    - Default character encoding for requests and responses
    - Welcome files (the first page to show when hitting the root URL)

    NOTE: Servlets and Filters in this project are registered using
    Java annotations (@WebServlet, @WebFilter) rather than XML entries
    here. That keeps configuration close to the code.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>ExamPro - Exam Management System</display-name>

    <!--
        Request Character Encoding
        Forces all incoming request bodies to be parsed as UTF-8.
        Without this, form data with special characters can break.
    -->
    <request-character-encoding>UTF-8</request-character-encoding>

    <!--
        Response Character Encoding
        All responses (HTML, JSON, etc.) will be sent as UTF-8.
    -->
    <response-character-encoding>UTF-8</response-character-encoding>

    <!--
        Welcome Files
        When someone visits http://localhost:8080/ExamPro/
        Tomcat will look for these files in order.
    -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!--
        Session Configuration
        - 30 minute session timeout (inactive sessions expire)
        - HttpOnly cookies prevent JavaScript from reading the session ID
          (protects against XSS attacks stealing sessions)
        - Secure attribute should be enabled in production with HTTPS
    -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- In production behind HTTPS, uncomment: <secure>true</secure> -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!--
        Error Pages
        Custom error pages instead of ugly Tomcat stack traces.
        (JSP files for these will be created in later modules)
    -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

</web-app>
